{
  "name": "discord-claude-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that drives a full Claude Code agent (shell, files, web, GitHub) from your phone",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
