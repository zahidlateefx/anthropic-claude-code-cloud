# Enable Discord and/or WhatsApp. At least ONE transport must be configured.

# ---- Discord (optional) ----
# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your Discord user ID(s), comma separated. ONLY these users can command the agent.
# (Discord: Settings -> Advanced -> Developer Mode ON, then right-click your name -> Copy User ID)
DISCORD_OWNER_IDS=
# Optional: only listen in these channel IDs (comma separated).
# Empty = DMs + any channel where the bot is @mentioned.
DISCORD_CHANNEL_IDS=

# ---- WhatsApp (optional) ----
# Your WhatsApp number(s) with country code, comma separated. ONLY these can command the agent.
# e.g. 923001234567 . On first run scan the QR from the logs (WhatsApp -> Linked Devices).
# Leave empty to disable WhatsApp.
WHATSAPP_OWNER_NUMBERS=

# ---- Claude ----
# Option A: API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Option B: leave the key empty and run `claude login` once on this machine (uses your Claude subscription).

# Model for the agent (default: claude-opus-5)
AGENT_MODEL=claude-opus-5
# Directory where the agent works. Files it creates live here. (default: ./workspace)
AGENT_WORKSPACE=./workspace
# bypassPermissions | acceptEdits | auto | default
# bypassPermissions = runs any command without asking (full autonomy like the reel). Only on a machine you own.
AGENT_PERMISSION_MODE=bypassPermissions
# Max tool-use turns per request
AGENT_MAX_TURNS=80
# Name the bot answers to in the system prompt
AGENT_NAME=Friday
# Timezone for schedules/reminders (default: system timezone)
AGENT_TIMEZONE=Asia/Karachi

# ---- PC bridge (optional, for cloud + PC worker setup) ----
# Set a long random secret to enable the bridge on the CLOUD host. The PC worker
# uses the SAME token to connect. Leave empty for a single-machine setup.
BRIDGE_TOKEN=
# Port the cloud listens on for the PC worker (open it in the VM firewall).
BRIDGE_PORT=8787
